{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Murat Project Engineer Verification State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "captured_at", "excluded_paths", "git", "checkpoint_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "state": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "excluded_paths": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha",
        "base_ref",
        "base_sha",
        "entries",
        "content",
        "committed_diff_sha256",
        "staged_diff_sha256",
        "unstaged_diff_sha256",
        "fingerprint_sha256"
      ],
      "properties": {
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "base_ref": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 2}
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"type": "null"}
            ]
          }
        },
        "committed_diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "staged_diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "unstaged_diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "invalidation_reason": {"type": "string"}
  }
}
