{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murat-ai-stack.local/schemas/compute-budget-v1.json",
  "title": "Murat Project Engineer AI Compute Budget Snapshot",
  "description": "Canonical compute-budget snapshot for MPE. The top-level metric is AI Compute Budget, not an OpenAI-only cost. observed / estimated / unobserved usage are distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project", "compute_budget", "preflight", "usage", "forecast", "routing", "efficiency"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "compute_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "planned_budget", "hard_limit"],
      "properties": {
        "currency": {"type": "string", "const": "USD"},
        "planned_budget": {"type": ["number", "null"], "minimum": 0},
        "hard_limit": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens_min", "input_tokens_expected", "input_tokens_max", "output_tokens_min", "output_tokens_expected", "output_tokens_max", "estimated_cost_min", "estimated_cost_expected", "estimated_cost_max", "confidence"],
      "properties": {
        "input_tokens_min": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens_expected": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens_max": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_min": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_expected": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_max": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_min": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_expected": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_max": {"type": ["number", "null"], "minimum": 0},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "estimated_cost", "measurement"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost": {"type": ["number", "null"], "minimum": 0},
        "measurement": {"type": "string", "enum": ["observed", "estimated", "unobserved"]}
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_total_cost_min", "estimated_total_cost_expected", "estimated_total_cost_max", "remaining_cost_expected", "confidence"],
      "properties": {
        "estimated_total_cost_min": {"type": ["number", "null"], "minimum": 0},
        "estimated_total_cost_expected": {"type": ["number", "null"], "minimum": 0},
        "estimated_total_cost_max": {"type": ["number", "null"], "minimum": 0},
        "remaining_cost_expected": {"type": ["number", "null"], "minimum": 0},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_stack", "actual_provider_mix"],
      "properties": {
        "recommended_stack": {"type": "array", "items": {"type": "string"}},
        "actual_provider_mix": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_progress_percent", "budget_consumed_percent", "cost_per_progress_percent"],
      "properties": {
        "project_progress_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "budget_consumed_percent": {"type": ["number", "null"], "minimum": 0},
        "cost_per_progress_percent": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_status": {"type": "string", "enum": ["GREEN", "YELLOW", "ORANGE", "RED", "UNOBSERVED"]},
        "burn_rate_status": {"type": "string", "enum": ["OK", "BURN_RATE_ANOMALY", "UNOBSERVED"]},
        "burn_rate_ratio": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
