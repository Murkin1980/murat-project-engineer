{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murat-ai-stack.local/schemas/prospective-evaluation-v0.1.json",
  "title": "EXP-12 prospective case evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "registration_ref", "registration_sha256", "execution_ref", "execution_sha256", "engine_ref", "engine_sha256", "engine_output", "pre_registered_human_label", "observed_final_classification", "human_engine_agreement", "engine_observed_agreement", "human_observed_agreement", "state", "evaluator_version"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^EXP12-P-[0-9]{3}$"},
    "registration_ref": {"type": "string", "minLength": 1},
    "registration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_ref": {"type": "string", "minLength": 1},
    "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine_ref": {"const": "scripts/triage_engine.py"},
    "engine_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine_output": {"$ref": "TRIAGE_OUTPUT.schema.json"},
    "pre_registered_human_label": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_tier", "human_approval_required", "rationale"],
      "properties": {"risk_tier": {"enum": ["FAST", "VERIFIED", "DEEP-CHANGE"]}, "human_approval_required": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}}
    },
    "observed_final_classification": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_tier", "human_approval_required"],
      "properties": {"risk_tier": {"enum": ["FAST", "VERIFIED", "DEEP-CHANGE"]}, "human_approval_required": {"type": "boolean"}}
    },
    "human_engine_agreement": {"type": "boolean"},
    "engine_observed_agreement": {"type": "boolean"},
    "human_observed_agreement": {"type": "boolean"},
    "state": {"const": "EVALUATED"},
    "evaluator_version": {"const": "0.1.0"}
  }
}
