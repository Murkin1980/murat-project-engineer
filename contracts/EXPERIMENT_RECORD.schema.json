{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murat-ai-stack.local/schemas/experiment-record-v1.json",
  "title": "Murat Project Engineer Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_class",
    "project",
    "risk_tier",
    "baseline_or_coordinator",
    "experts_or_team",
    "playbook",
    "route_profile",
    "duration",
    "deterministic_failures",
    "reviewer_findings_useful",
    "reviewer_false_positives",
    "rework_count",
    "human_interventions",
    "escaped_defect_after_pass",
    "interruption_recovery_result",
    "fan_out_fan_in_needed",
    "durable_state_needed",
    "workflow_engine_pressure",
    "persistent_agent_pressure",
    "approximate_cost",
    "notes"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_class": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "risk_tier": {"type": "string", "enum": ["FAST", "VERIFIED", "DEEP-CHANGE"]},
    "baseline_or_coordinator": {"type": "string", "enum": ["baseline", "murat-project-engineer"]},
    "experts_or_team": {"type": "array", "items": {"type": "string"}},
    "playbook": {"type": ["string", "null"]},
    "route_profile": {"type": ["string", "null"]},
    "duration": {"type": ["string", "number", "null"]},
    "deterministic_failures": {"type": ["integer", "null"], "minimum": 0},
    "reviewer_findings_useful": {"type": ["integer", "null"], "minimum": 0},
    "reviewer_false_positives": {"type": ["integer", "null"], "minimum": 0},
    "rework_count": {"type": ["integer", "null"], "minimum": 0},
    "human_interventions": {"type": ["integer", "null"], "minimum": 0},
    "escaped_defect_after_pass": {"type": ["boolean", "null"]},
    "interruption_recovery_result": {"type": ["string", "null"]},
    "fan_out_fan_in_needed": {"type": ["boolean", "null"]},
    "durable_state_needed": {"type": ["boolean", "null"]},
    "workflow_engine_pressure": {"type": ["boolean", "null"]},
    "persistent_agent_pressure": {"type": ["boolean", "null"]},
    "approximate_cost": {"type": ["string", "number", "null"]},
    "notes": {"type": "string"}
  }
}
