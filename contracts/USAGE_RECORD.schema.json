{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murat-ai-stack.local/schemas/usage-record-v1.json",
  "title": "Murat Project Engineer Run Usage Record",
  "description": "Canonical per-run usage telemetry. Captured automatically by scripts/usage_instrumentation.py. observed / estimated / unobserved are derived from measurement_source and never promoted; missing data is null, never a fabricated zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "model",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "observed_cost",
    "model_calls",
    "tool_calls",
    "retries",
    "start_time",
    "end_time",
    "progress_checkpoints",
    "measurement_source",
    "measurement"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "observed_cost": {"type": ["number", "null"], "minimum": 0},
    "model_calls": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "retries": {"type": ["integer", "null"], "minimum": 0},
    "start_time": {"type": ["string", "null"], "format": "date-time"},
    "end_time": {"type": ["string", "null"], "format": "date-time"},
    "progress_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["progress_percent", "cost_usd", "measurement_source"],
        "properties": {
          "progress_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "cost_usd": {"type": "number", "minimum": 0},
          "measurement_source": {
            "type": "string",
            "enum": ["provider_api", "router_billing", "usage_api", "execution_log", "price_reconstruction", "operator_estimate", "none"]
          }
        }
      }
    },
    "measurement_source": {
      "type": "string",
      "enum": ["provider_api", "router_billing", "usage_api", "execution_log", "price_reconstruction", "operator_estimate", "none"]
    },
    "measurement": {"type": "string", "enum": ["observed", "estimated", "unobserved"]}
  }
}
